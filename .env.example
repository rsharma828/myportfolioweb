# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# Admin — 1) Generate bcrypt hash:
#   pnpm exec tsx -e "import bcrypt from 'bcryptjs'; bcrypt.hash('your-password',12).then(console.log)"
# 2) Recommended: put hash in .env WITHOUT any `$` (avoids Next/dotenv mangling):
#   node scripts/bcrypt-hash-to-base64.mjs '$2b$12$...paste_full_hash...'
#   Copy the one-line base64 output into ADMIN_PASSWORD_HASH_B64 below.
# Alternative: ADMIN_PASSWORD_HASH with the full hash in single quotes (can still break in some setups).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH_B64=""
# ADMIN_PASSWORD_HASH=""

# Session (32+ chars)
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
